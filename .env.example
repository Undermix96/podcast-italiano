# ============================================================
# podcast-italiano — configurazione stack
# Copia questo file in .env e compila i valori obbligatori.
# Non committare mai il file .env (è già in .gitignore).
# ============================================================


# ------------------------------------------------------------
# Immagine DockerHub del generator
# Formato: <dockerhub-username>/podcast-italiano-generator:<tag>
# Costruisci e pubblica con: ./build.sh
# ------------------------------------------------------------
GENERATOR_IMAGE=tuousername/podcast-italiano-generator:latest


# ------------------------------------------------------------
# OpenRouter — LLM per riassunto e composizione script podcast
# ------------------------------------------------------------

# Chiave API OpenRouter (obbligatoria)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modello da usare. Esempi:
#   anthropic/claude-sonnet-5   (qualità scrittura italiana ottima, ~€2-4/mese)
#   google/gemini-2.5-flash     (più economico, italiano solido)
#   deepseek/deepseek-chat-v3-5 (quasi gratis, valido per test)
OPENROUTER_MODEL=anthropic/claude-sonnet-5


# ------------------------------------------------------------
# Feed RSS da monitorare (separati da virgola, nessuno spazio)
# ------------------------------------------------------------
RSS_FEEDS=https://www.ansa.it/sito/ansait_rss.xml,https://www.ilpost.it/feed/,https://www.repubblica.it/rss/homepage/rss2.0.xml,https://www.ilsole24ore.com/rss/italia.xml

# Numero massimo di articoli da elaborare per episodio
# (doppio tetto con MAX_WORDS in generate_episode.py)
MAX_ARTICLES=12


# ------------------------------------------------------------
# Podcast — metadati del canale
# ------------------------------------------------------------
PODCAST_TITLE=Rassegna Stampa
PODCAST_AUTHOR=Giulia

# Indirizzo email del podcast (usato da Podcastify nel feed iTunes)
PODCAST_EMAIL=podcast@local.invalid


# ------------------------------------------------------------
# Scheduling cron (formato standard: minuto ora giorno mese giorno_settimana)
# Esempi:
#   0 6 * * *   ogni giorno alle 06:00 (Europe/Rome, vedi Dockerfile)
#   0 7 * * 1-5 solo lun-ven alle 07:00
#   0 5 * * *   ogni giorno alle 05:00
# ------------------------------------------------------------
CRON_SCHEDULE=0 6 * * *


# ------------------------------------------------------------
# TTS — openedai-speech (XTTS-v2)
# ------------------------------------------------------------

# URL interno del container xtts (non modificare se usi il docker-compose incluso)
XTTS_URL=http://xtts:8000/v1/audio/speech

# Nome voce: deve corrispondere a una chiave in xtts-config/voice_to_speaker.yaml
XTTS_VOICE=it_voce

# Porta su cui xtts è raggiungibile DALL'HOST (per test manuali con
# test-tts/test_tts_params.sh o curl diretto). Cambiala se 8000 è già
# occupata da un altro servizio sul tuo host.
XTTS_HOST_PORT=8000


# ------------------------------------------------------------
# Percorsi interni al container generator (non modificare
# salvo che tu non cambi i volumi in docker-compose.yml)
# ------------------------------------------------------------
OUTPUT_DIR=/data/public/rassegna-stampa
YAML_PATH=/data/podcasts/rassegna-stampa-podcast.yaml
STATE_PATH=/data/state/seen.json
LOG_PATH=/data/logs/podcast.log


# ------------------------------------------------------------
# Podcastify — server feed RSS
# ------------------------------------------------------------

# Porta esposta sull'host per il feed e i file audio
PODCASTIFY_HOST_PORT=8080

# URL pubblico con cui Podcastify costruisce i link nel feed RSS.
# Se ascolti solo sulla LAN, usa l'IP del tuo host Docker.
# Se è dietro un reverse proxy, metti il dominio completo.
# Esempio LAN:    http://192.168.1.100:8080
# Esempio proxy:  https://podcast.tuodominio.it
PUBLIC_BASE_URL=http://localhost:8080
